<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StudyPilot.Models"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:Name="NotesPageRoot"
    x:DataType="viewModels:NotesViewModel"
    Title="Notes">
    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Image Source="illust_notes.png" HeightRequest="64" Aspect="AspectFit" HorizontalOptions="Start" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Notes" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Capture ideas and lecture notes" Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Add" Command="{Binding AddCommand}" Style="{StaticResource FabButtonStyle}" VerticalOptions="Center" />
            </Grid>
            <Border Padding="4" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Picker Title="Filter by subject" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" />
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Notes}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,40">
                    <Image Source="empty_state.png" HeightRequest="100" WidthRequest="160" Opacity="0.75" />
                    <Label Text="No notes yet. Start capturing your ideas." Style="{StaticResource EmptyStateLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NoteItem">
                    <Border Style="{StaticResource AppCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Edit" Command="{Binding Source={x:Reference NotesPageRoot}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButtonStyle}" />
                                <Button Grid.Column="2" Text="Delete" Command="{Binding Source={x:Reference NotesPageRoot}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" Style="{StaticResource DangerButtonStyle}" />
                            </Grid>
                            <Border Padding="8,4" BackgroundColor="{StaticResource InfoLight}" StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Label Text="{Binding Subject}" FontSize="12" TextColor="{StaticResource Info}" FontFamily="OpenSansSemibold" />
                            </Border>
                            <Label Text="{Binding Content}" MaxLines="3" LineBreakMode="TailTruncation" Style="{StaticResource BodyLabel}" />
                            <Image Source="{Binding ImagePath}" HeightRequest="140" Aspect="AspectFill">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding ImagePath}" Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
