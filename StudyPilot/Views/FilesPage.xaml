<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StudyPilot.Models"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:Name="FilesPageRoot"
    x:DataType="viewModels:FilesViewModel"
    Title="Files">
    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Image Source="illust_files.png" HeightRequest="64" Aspect="AspectFit" HorizontalOptions="Start" />
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Study Files" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="PDFs, images, and study materials" Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Upload" Command="{Binding UploadCommand}" Style="{StaticResource FabButtonStyle}" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Files}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,40">
                    <Image Source="empty_state.png" HeightRequest="100" WidthRequest="160" Opacity="0.75" />
                    <Label Text="No files uploaded yet. Tap Upload to add study materials." Style="{StaticResource EmptyStateLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:StudyFileItem">
                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="{StaticResource InfoLight}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="📄" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding DisplayName}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding FileType, StringFormat='{0} file'}" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding CreatedAt, StringFormat='Saved {0:dd MMM yyyy}'}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Button Text="Open" Command="{Binding Source={x:Reference FilesPageRoot}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButtonStyle}" Padding="8,4" />
                                <Button Text="Delete" Command="{Binding Source={x:Reference FilesPageRoot}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" Style="{StaticResource DangerButtonStyle}" Padding="8,4" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
