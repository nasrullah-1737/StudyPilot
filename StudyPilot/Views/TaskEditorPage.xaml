<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.TaskEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:DataType="viewModels:TaskEditorViewModel"
    Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Image Source="illust_tasks.png" HeightRequest="56" Aspect="AspectFit" HorizontalOptions="Start" />
            <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitleLabel}" />

            <Border Style="{StaticResource AppCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Task title" Style="{StaticResource FormFieldLabel}" />
                    <Border Padding="12,4" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry Placeholder="What needs to be done?" Text="{Binding TaskTitle}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Description" Style="{StaticResource FormFieldLabel}" />
                    <Border Padding="12" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Editor Placeholder="Add details..." Text="{Binding Description}" MinimumHeightRequest="120" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Deadline date" Style="{StaticResource FormFieldLabel}" />
                    <DatePicker Date="{Binding DeadlineDate}" />

                    <Label Text="Deadline time" Style="{StaticResource FormFieldLabel}" />
                    <TimePicker Time="{Binding DeadlineTime}" />

                    <Label Text="Priority" Style="{StaticResource FormFieldLabel}" />
                    <Picker ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Save Task" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
