<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.NoteEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:DataType="viewModels:NoteEditorViewModel"
    Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitleLabel}" />

            <Border Style="{StaticResource AppCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Title" Style="{StaticResource FormFieldLabel}" />
                    <Border Padding="12,4" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry Placeholder="Note title" Text="{Binding NoteTitle}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Subject" Style="{StaticResource FormFieldLabel}" />
                    <Border Padding="12,4" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry Placeholder="e.g. Mathematics" Text="{Binding Subject}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Content" Style="{StaticResource FormFieldLabel}" />
                    <Border Padding="12" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Editor Placeholder="Write your note..." Text="{Binding Content}" MinimumHeightRequest="160" BackgroundColor="Transparent" />
                    </Border>

                    <Image Source="{Binding ImagePath}" HeightRequest="180" Aspect="AspectFill">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding ImagePath}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="📷 Pick Image" Command="{Binding PickImageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Remove" Command="{Binding RemoveImageCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save Note" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
