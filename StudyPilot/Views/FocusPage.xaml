<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.FocusPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:DataType="viewModels:FocusViewModel"
    Title="Focus">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Image Source="illust_focus.png" HeightRequest="64" Aspect="AspectFit" HorizontalOptions="Center" />

            <Border Style="{StaticResource AppCardStyle}" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="24" Padding="8">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Pomodoro Focus" Style="{StaticResource PageTitleLabel}" HorizontalOptions="Center" />
                        <Label Text="{Binding SessionLabel}" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Circular timer visual -->
                    <Border
                        HeightRequest="220"
                        WidthRequest="220"
                        HorizontalOptions="Center"
                        Stroke="{StaticResource BorderFocus}"
                        StrokeThickness="8"
                        BackgroundColor="{StaticResource SurfaceMuted}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="110" />
                        </Border.StrokeShape>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding TimerText}" FontFamily="OpenSansSemibold" FontSize="52" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" />
                            <Label Text="minutes remaining" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <ProgressBar Progress="{Binding Progress}" HeightRequest="10" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="{Binding StartPauseText}" Command="{Binding StartPauseCommand}" />
                        <Button Grid.Column="1" Text="Reset" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource AppCardStyle}" BackgroundColor="{StaticResource SurfaceMuted}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 Focus Tips" Style="{StaticResource SectionLabel}" />
                    <Label Text="• Work in 25-minute sprints with 5-minute breaks" Style="{StaticResource BodyLabel}" />
                    <Label Text="• Put your phone on silent during focus sessions" Style="{StaticResource BodyLabel}" />
                    <Label Text="• Take a longer 15-minute break every 4 sessions" Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
