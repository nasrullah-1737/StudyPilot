<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.ThemedAlertPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#990F172A"
    Shell.NavBarIsVisible="False">
    <Grid Padding="24">
        <Border
            x:Name="DialogCard"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="400"
            Padding="0"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource BorderBrush}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#406366F1" Offset="0,8" Radius="24" Opacity="0.25" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Border
                    x:Name="AccentBar"
                    HeightRequest="5"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20,20,0,0" />
                    </Border.StrokeShape>
                </Border>

                <VerticalStackLayout Padding="22,18,22,20" Spacing="14">
                    <Label
                        x:Name="TitleLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="20"
                        TextColor="{StaticResource TextPrimary}" />
                    <Label
                        x:Name="MessageLabel"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        LineBreakMode="WordWrap"
                        TextColor="{StaticResource TextSecondary}" />

                    <Grid x:Name="ButtonRow" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button
                            x:Name="CancelButton"
                            Grid.Column="0"
                            Clicked="OnCancelClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsVisible="False" />
                        <Button
                            x:Name="AcceptButton"
                            Grid.Column="1"
                            Clicked="OnAcceptClicked"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
