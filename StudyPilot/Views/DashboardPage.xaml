<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyPilot.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StudyPilot.Models"
    xmlns:viewModels="clr-namespace:StudyPilot.ViewModels"
    x:DataType="viewModels:DashboardViewModel"
    Title="Dashboard"
    Shell.NavBarIsVisible="False">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <!-- Hero header -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding WelcomeText}" Style="{StaticResource HeroTitleLabel}" />
                            <Label Text="{Binding GreetingSubtitle}" Style="{StaticResource HeroSubtitleLabel}" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Row="0"
                            Grid.Column="1"
                            Source="logo_studypilot.png"
                            HeightRequest="64"
                            WidthRequest="64"
                            VerticalOptions="Start" />
                        <Image
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Source="hero_dashboard.png"
                            HeightRequest="100"
                            Aspect="AspectFill"
                            Margin="0,16,0,0" />
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="16,0,16,24" Spacing="16">
                    <!-- Stats grid -->
                    <Label Text="Today's Overview" Style="{StaticResource SectionLabel}" />
                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Pending" Style="{StaticResource StatTitleLabel}" />
                                <Label Text="{Binding PendingTasksCount}" Style="{StaticResource StatValueLabel}" TextColor="{StaticResource Warning}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Completed" Style="{StaticResource StatTitleLabel}" />
                                <Label Text="{Binding CompletedTasksCount}" Style="{StaticResource StatValueLabel}" TextColor="{StaticResource Success}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Classes Today" Style="{StaticResource StatTitleLabel}" />
                                <Label Text="{Binding TodayClassesCount}" Style="{StaticResource StatValueLabel}" TextColor="{StaticResource Info}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Notes Saved" Style="{StaticResource StatTitleLabel}" />
                                <Label Text="{Binding NotesCount}" Style="{StaticResource StatValueLabel}" TextColor="{StaticResource Accent}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick actions -->
                    <Label Text="Quick Actions" Style="{StaticResource SectionLabel}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Grid.Row="0" Grid.Column="0" Text="📝  New Note" Command="{Binding NavigateToNotesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Row="0" Grid.Column="1" Text="✅  Add Task" Command="{Binding NavigateToTasksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Row="1" Grid.Column="0" Text="⏱  Focus Mode" Command="{Binding NavigateToFocusCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Row="1" Grid.Column="1" Text="📂  My Files" Command="{Binding NavigateToFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <!-- Today's tasks -->
                    <Border Style="{StaticResource AppCardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Due Today" Style="{StaticResource SectionLabel}" />
                                <Label Grid.Column="1" Text="{Binding PendingTasksCount, StringFormat='{0} pending'}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding TodayTasks}" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Image Source="empty_state.png" HeightRequest="80" WidthRequest="140" Opacity="0.7" />
                                        <Label Text="All clear for today!" Style="{StaticResource EmptyStateLabel}" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Grid Padding="0,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border
                                                WidthRequest="4"
                                                HeightRequest="36"
                                                BackgroundColor="{StaticResource Primary}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="2" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" FontSize="15" />
                                                <Label Text="{Binding Deadline, StringFormat='Due {0:hh:mm tt}'}" Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Style="{StaticResource PriorityBadgeStyle}">
                                                <Label Text="{Binding Priority}" FontSize="11" TextColor="{StaticResource Info}" FontFamily="OpenSansSemibold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Today's classes -->
                    <Border Style="{StaticResource AppCardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Today's Classes" Style="{StaticResource SectionLabel}" />
                                <Button Grid.Column="1" Text="View All" Command="{Binding NavigateToScheduleCommand}" Style="{StaticResource GhostButtonStyle}" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding TodayClasses}" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label Text="No classes scheduled today." Style="{StaticResource EmptyStateLabel}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ClassScheduleItem">
                                        <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border
                                                Padding="10,6"
                                                BackgroundColor="{StaticResource InfoLight}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Info}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Subject}" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" FontSize="15" />
                                                <Label Text="{Binding Room, StringFormat='Room {0}'}" Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
