<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StudyPilot.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyPilot.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="StudyPilot">
    <TabBar Route="main">
        <ShellContent
            Title="Home"
            Icon="tab_home"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="dashboard" />
        <ShellContent
            Title="Notes"
            Icon="tab_notes"
            ContentTemplate="{DataTemplate views:NotesPage}"
            Route="notes" />
        <ShellContent
            Title="Tasks"
            Icon="tab_tasks"
            ContentTemplate="{DataTemplate views:TasksPage}"
            Route="tasks" />
        <ShellContent
            Title="Schedule"
            Icon="tab_schedule"
            ContentTemplate="{DataTemplate views:TimetablePage}"
            Route="schedule" />
        <ShellContent
            Title="Focus"
            Icon="tab_focus"
            ContentTemplate="{DataTemplate views:FocusPage}"
            Route="focus" />
        <ShellContent
            Title="Files"
            Icon="tab_files"
            ContentTemplate="{DataTemplate views:FilesPage}"
            Route="files" />
        <ShellContent
            Title="More"
            Icon="tab_more"
            ContentTemplate="{DataTemplate views:MorePage}"
            Route="more" />
    </TabBar>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="register" />
</Shell>
