<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Modern Indigo-Violet Study Theme -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryLight">#818CF8</Color>
    <Color x:Key="PrimaryDark">#4F46E5</Color>
    <Color x:Key="Accent">#8B5CF6</Color>
    <Color x:Key="AccentLight">#A78BFA</Color>

    <Color x:Key="Background">#F1F5F9</Color>
    <Color x:Key="BackgroundAlt">#E2E8F0</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F8FAFC</Color>

    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>

    <Color x:Key="Border">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <Color x:Key="BorderFocus">#C7D2FE</Color>

    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessLight">#D1FAE5</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="InfoLight">#DBEAFE</Color>

    <Color x:Key="GradientStart">#6366F1</Color>
    <Color x:Key="GradientEnd">#8B5CF6</Color>
    <Color x:Key="GradientAccent">#EC4899</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource GradientEnd}" Offset="0.6" />
        <GradientStop Color="{StaticResource GradientAccent}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
        <GradientStop Color="{StaticResource Accent}" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
